# Copy to backend/.env for local development. This template contains placeholders,
# not usable credentials. Never commit backend/.env or paste real keys into Git.

# Django and local database
DEBUG=True
DJANGO_SECRET_KEY=change-me-for-local-development
ALLOWED_HOSTS=localhost,127.0.0.1
REQUIRE_LOGIN_FOR_PUBLIC_SITE=False
# Leave DATABASE_URL empty to use the existing backend/db.sqlite3 local database.
# For Render, set DEBUG=False, a unique DJANGO_SECRET_KEY (50+ characters),
# DATABASE_URL to the existing PostgreSQL connection, REQUIRE_LOGIN_FOR_PUBLIC_SITE=True,
# production ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS, and CSRF_TRUSTED_ORIGINS
# in the Render dashboard. Do not copy local values into production.
DATABASE_URL=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5000,http://127.0.0.1:5000
CSRF_TRUSTED_ORIGINS=

# AI providers (optional; chatbot uses verified content when keys are absent)
AI_ENABLED=True
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_CONSERVE_QUOTA=True
GEMINI_MAX_RETRIES=2
GEMINI_RAG_LIMIT=4
GEMINI_REQUEST_TIMEOUT=25
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REQUEST_TIMEOUT=45
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Resend enquiry notifications (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Coach AI <onboarding@resend.dev>
ENQUIRY_NOTIFY_EMAIL=

# Optional SMTP email configuration (used when DEBUG=False and EMAIL_HOST is set)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Coach AI <noreply@vetri-it.com>

# Optional Admin bootstrap settings for reviewed deployments
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Chat request limits
CHAT_RATE_LIMIT=30/minute
CHAT_MAX_MESSAGE_LENGTH=2000
CHAT_MAX_ATTACHMENTS=3
CHAT_MAX_ATTACHMENT_BYTES=5242880
CHAT_MAX_DOCUMENT_CHARS=12000

# Optional semantic/vector retrieval. SQLite uses lexical retrieval by default.
# Leave VECTOR_RAG_ENABLED unset to auto-enable only when DATABASE_URL is configured.
# VECTOR_RAG_ENABLED=True
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=20
VECTOR_RAG_MIN_SCORE=0.65
