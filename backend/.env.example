# Local development (DEBUG=True — HTTP allowed, insecure SECRET_KEY fallback OK)
DEBUG=True
DJANGO_SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://vetriitsystems.com,https://www.vetriitsystems.com,https://vetri-chatbot-ui.onrender.com

# Production (Render API — see render.yaml; DEBUG must be False)
# DEBUG=False
# DJANGO_SECRET_KEY=<unique secret — required, at least 50 characters>
# DATABASE_URL=<set automatically on Render from vetri-chatbot-db PostgreSQL>
# ALLOWED_HOSTS=vetri-chatbot-1.onrender.com
# CORS_ALLOWED_ORIGINS=https://vetri-chatbot-ui.onrender.com,https://vetriitsystems.com,https://www.vetriitsystems.com
# CSRF_TRUSTED_ORIGINS=https://vetri-chatbot-1.onrender.com
#
# Enquiry email notifications (Render free tier — use Resend, not Gmail SMTP)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Coach AI <onboarding@resend.dev>
# ENQUIRY_NOTIFY_EMAIL=your-resend-signup-email@example.com
#
# IMPORTANT: with onboarding@resend.dev, ENQUIRY_NOTIFY_EMAIL must be the EXACT
# email you used to sign up for Resend (not support@vetri-it.com until you verify that domain).
#
# Optional SMTP for local dev only (blocked on Render free):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-user@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Coach AI <noreply@vetri-it.com>
#
# Simulate production checks locally:
#   set DEBUG=False
#   set DJANGO_SECRET_KEY=<at-least-50-character-random-secret>
#   set ALLOWED_HOSTS=vetri-chatbot-1.onrender.com
#   python manage.py check --deploy

# Admin user for Render (free tier has no Shell — created on deploy via ensure_superuser)
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=<at-least-8-characters>
# DJANGO_SUPERUSER_EMAIL=admin@vetriit.com

# Chat API rate limit (POST /api/chatbot/chat/ per IP)
CHAT_RATE_LIMIT=30/minute

# Pause all LLM calls (Gemini/Grok/DeepSeek) — uses verified KB only. Keys stay in place.
# Set false until quota resets, then set true again.
AI_ENABLED=true

# Google AI Studio — create key at https://aistudio.google.com/apikey (usually starts with AIza...)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash
# Free tier: 1 Gemini API call per chat message (primary model only, no retries).
GEMINI_CONSERVE_QUOTA=true
# When GEMINI_CONSERVE_QUOTA=false: retries per model on 503/timeout (1–5).
GEMINI_MAX_RETRIES=2
# Smaller RAG context saves tokens on free-tier quota (2–8, default 4).
GEMINI_RAG_LIMIT=4
# Request timeout in seconds (10–60, default 25).
GEMINI_REQUEST_TIMEOUT=25

# Secondary backup AI when Gemini is busy (503) or quota exceeded (429)
# Create a key at https://console.x.ai/
XAI_API_KEY=your-xai-api-key
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.6
# Request timeout in seconds (10–60, default 45).
GROK_REQUEST_TIMEOUT=45


