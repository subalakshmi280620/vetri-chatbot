# Vetri AI Coach — Frontend environment variables
# Copy to `.env` for local development:  cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to the client.
# Do NOT put secrets (API keys, Django SECRET_KEY) here — they would be public.

# ── Local development (default) ──────────────────────────────────────────────
VITE_API_URL=http://127.0.0.1:8000

# ── Production (Render Static Site: vetri-chatbot-ui) ────────────────────────
# Set this in the Render dashboard BEFORE building the static site:
#   VITE_API_URL=https://vetri-chatbot-1.onrender.com
#
# Or build locally for production preview:
#   set VITE_API_URL=https://vetri-chatbot-1.onrender.com
#   npm run build
